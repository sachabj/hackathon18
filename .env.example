# Copier ce fichier en .env.local et remplir avec les clés du projet Supabase
# (Supabase → Project Settings → API). Ne JAMAIS committer .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx

# Assistant IA de /publier (photo ou texte → formulaire pré-rempli). Côté serveur uniquement :
# surtout PAS de préfixe NEXT_PUBLIC_. Sans clé, le formulaire marche normalement, sans IA.
# Gemini (clé gratuite sur https://aistudio.google.com/apikey) est prioritaire ; sinon Claude.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
